# Frontend environment variables
# Copy to .env or .env.local and adjust as needed.

# API base URL for backend requests.
# In development with Vite dev server, leave unset to use the Vite proxy (/api).
# In production behind a reverse proxy, leave unset to use relative path (/api).
# Only set this if the frontend and backend are served from different origins.
# VITE_API_BASE_URL=http://127.0.0.1:8000