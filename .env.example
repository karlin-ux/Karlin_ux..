# Copy to .env and replace placeholders. Never commit .env.

# === Django Core ===
DJANGO_SECRET_KEY=replace-with-a-long-random-value-at-least-32-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_SECURE_PROXY_SSL_HEADER=false

# === CORS (optional — defaults to CSRF_TRUSTED_ORIGINS) ===
# DJANGO_CORS_ALLOWED_ORIGINS=https://example.com

# === Google OAuth ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# === Database ===
POSTGRES_DB=karlin_ux
POSTGRES_USER=karlin_ux
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# === Email ===
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@localhost
CONTACT_RECIPIENT_EMAIL=contact@localhost

# === Donation Catalogue ===
DONATION_PRODUCTS_MAX=5

# === Bitcoin ===
DONATION_BTC_ENABLED=true
DONATION_BTC_RECEIVE_ADDRESS=
DONATION_BTC_NETWORK=

# === PayPal ===
DONATION_PAYPAL_ENABLED=true
DONATION_PAYPAL_URL=

# === EFT ===
DONATION_EFT_ENABLED=true
DONATION_EFT_ACCOUNT_HOLDER=
DONATION_EFT_BANK_NAME=
DONATION_EFT_ACCOUNT_NUMBER=
DONATION_EFT_ACCOUNT_TYPE=
DONATION_EFT_BRANCH_CODE=
DONATION_EFT_REFERENCE_PREFIX=
DONATION_EFT_CURRENCY=ZAR

# === Frontend ===
VITE_API_BASE_URL=http://127.0.0.1:8000
